# Dependances
/node_modules
/.pnp
.pnp.js

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build

# Journal de tests et artefacts de build
coverage/

# Var d'environnement (jamais committer !)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Fichiers parasites
/E

# Editeur : preferences locales, jamais partagees
.vscode/

# Worktrees d'agent (.kilo/worktrees/curved-kumquat) : depot git imbrique
# contenant une branche de travail distincte. Il duplique tout le code source,
# ce qui pollue les recherches dans l'IDE et double les resultats de grep.
# NE PAS supprimer ce repertoire : il porte des commits absents de `main`
# (cf. `git log main..c3b0880`). On l'ignore seulement.
.kilo/

# Supabase local
supabase/.temp
supabase/.branches

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Divers
.DS_Store
*.pem
.vercel
*.tsbuildinfo
coverage/
E
