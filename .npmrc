# `legacy-peer-deps` est necessaire pour @vercel/analytics.
#
# Ce paquet declare des peers optionnels pour sept frameworks (vue, nuxt,
# svelte, remix…), dont @sveltejs/kit — qui exige vite 8. Le projet utilise
# Vitest 2, qui impose vite 5. npm tente malgre tout de resoudre le peer
# svelte et echoue en ERESOLVE, alors que ces peers sont marques optionnels :
# c'est un bug connu de npm, pas un vrai conflit.
#
# Le drapeau est pose ICI, et pas seulement sur la ligne de commande, pour une
# raison precise : Vercel lance `npm install` tout seul au build. Sans ce
# fichier, le build echouerait sur la meme erreur — alors que tout est correct
# en local. Le depot doit porter la regle, pas le developpeur.
#
# Effet de bord assume : npm ne verifie plus les peers du tout. Si une future
# dependance introduit un vrai conflit, il ne sera plus signale a l'install.
legacy-peer-deps=true