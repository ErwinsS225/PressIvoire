# =============================================================================
# PressingPro — variables d'environnement
# Copier ce fichier en `.env.local` puis remplir les vraies valeurs.
#   cp .env.example .env.local
# ⚠ Ne JAMAIS committer .env.local (deja dans .gitignore).
# =============================================================================

# --- Supabase (obligatoire) ---------------------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role : UNIQUEMENT serveur (Edge Functions, scripts). Jamais en client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PressingPro

# --- CinetPay (paiement mobile money CI : Wave, Orange, MTN, Moov) ------------
# https://admin.cinetpay.com > Integration > API
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_MODE=sandbox                 # sandbox | production
CINETPAY_CALLBACK_URL=http://localhost:3000/api/payments/callback

# --- SMS Orange CI (notifications commande) ----------------------------------
# Orange Business CI API SMS (ou provider compatible)
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=PRESSINGPRO

# --- WhatsApp Business API (optionnel, Phase 5) -------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=pressingpro_order_update

# --- Email (Supabase Auth) ----------------------------------------------------
# ⚠ IMPORTANT : activer SMTP dans Supabase > Authentication > SMTP Settings,
#   sans quoi l'inscription / la connexion par email echoue silencieusement.
SUPABASE_AUTH_SMTP_ENABLED=false

# --- Divers -------------------------------------------------------------------
NEXT_ENCRYPTION_KEY=
