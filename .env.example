# =============================================================================
# PressIvoire — variables d'environnement
# Copier ce fichier en `.env.local` puis remplir les vraies valeurs.
#   cp .env.example .env.local
# ⚠ Ne JAMAIS committer .env.local (deja dans .gitignore).
# =============================================================================

# --- Supabase (obligatoire) ---------------------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role : UNIQUEMENT serveur (Route Handlers, scripts). Jamais en client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nouveau format de cles (Project Settings > API Keys). `publishable` remplace
# `anon` ; `secret` remplace `service_role`. Les deux generations restent
# acceptees — les variables ci-dessus suffisent a l'application, celles-ci
# servent aux scripts et au portail.
SUPABASE_PROJECT_ID=xxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PressIvoire

# --- Passerelle de paiement — Wave Checkout -----------------------------------
# Abonnement au plan Pro (mobile money ivoirien : Orange, MTN, Moov).
# https://business.wave.com > Developers
#
# WAVE_API_KEY       : cle d'API. SERVEUR UNIQUEMENT — ne jamais l'exposer au
#                      client, elle peut deplacer de l'argent.
# WAVE_WEBHOOK_SECRET : secret du webhook. SANS lui, la notification est
#                      refusee : c'est volontaire, un webhook non verifie
#                      offrirait un abonnement a quiconque POST l'URL.
#
# Enregistrez le webhook sur : https://<votre-domaine>/api/webhooks/wave
# Wave ne peut pas joindre localhost — il faut un deploiement pour recevoir
# de vrais evenements.
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# --- SMS Orange CI (notifications commande) ----------------------------------
# Orange Business CI API SMS (ou provider compatible)
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=PRESSIVOIRE

# --- WhatsApp Business API (optionnel, Phase 5) -------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=pressivoire_order_update

# --- Email (Supabase Auth) ----------------------------------------------------
# ⚠ IMPORTANT : activer SMTP dans Supabase > Authentication > SMTP Settings,
#   sans quoi l'inscription / la connexion par email echoue silencieusement.
SUPABASE_AUTH_SMTP_ENABLED=false

# --- Deploiement Vercel -------------------------------------------------------
# Next.js est detecte automatiquement : aucune configuration de build n'est
# necessaire (framework preset Next.js, commande `npm run build`).
#
# VARIABLES A RENSEIGNER (Settings > Environment Variables) — Production ET
# Preview, sinon les pull requests cassent :
#
#   NEXT_PUBLIC_SUPABASE_URL        publique  (fige au BUILD)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   publique  (fige au BUILD)
#   NEXT_PUBLIC_APP_URL             publique  (fige au BUILD)
#   NEXT_PUBLIC_APP_NAME            publique  (fige au BUILD, defaut "PressIvoire")
#   SUPABASE_SERVICE_ROLE_KEY       SECRE     (jamais NEXT_PUBLIC_)
#   SUPABASE_PROJECT_ID             SECRE
#   SUPABASE_PUBLISHABLE_KEY        SECRE
#   SUPABASE_SECRET_KEY             SECRE
#   SUPABASE_JWKS_URL               SECRE
#
# ⚠ Les variables NEXT_PUBLIC_* sont INLINEES DANS LE BUNDLE au moment du
# build. Si elles manquent, le build REUSSIT malgre tout et l'application
# est cassee a l'execution : un deploiement « vert » ne prouve donc rien.
# Verifiez en ouvrant le site, pas seulement le statut du build.
#
# Les variables SANS `NEXT_PUBLIC_` (SUPABASE_SERVICE_ROLE_KEY) ne quittent
# jamais le serveur. Ne les prefixez surtout pas de NEXT_PUBLIC_.
#
# Facultatif, une fois le paiement actif :
#   WAVE_API_KEY, WAVE_WEBHOOK_SECRET
#   (le webhook se declare sur https://<votre-domaine>/api/webhooks/wave)
#
# MIGRATIONS : la CI n'applique pas le schema. Apres le premier deploiement,
# appliquez les migrations sur la base cible :
#   node scripts/db-apply.mjs --file supabase/migrations/001_init.sql
#   ... puis 002 a 010, dans l'ordre.
# ---------------------------------------------------------------------------

# --- Divers -------------------------------------------------------------------
NEXT_ENCRYPTION_KEY=
